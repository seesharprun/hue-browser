{
  "name": "hue-browser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "biome ci --use-editorconfig=true --css-parse-tailwind-directives=true src theme.css blume.config.ts next.config.ts postcss.config.mjs",
    "test": "node --test src/lib/bridges/types.test.ts src/lib/bridges/discovery-error.test.ts src/lib/devices/parse.test.ts",
    "format": "biome check --write --use-editorconfig=true --css-parse-tailwind-directives=true src theme.css blume.config.ts next.config.ts postcss.config.mjs",
    "docs:prepare": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('src/app/icon.svg','public/favicon.svg')\"",
    "predocs:dev": "npm run docs:prepare",
    "docs:dev": "blume dev --port 4000",
    "predocs:build": "npm run docs:prepare",
    "docs:build": "blume build"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "blume": "^2.0.3",
    "daisyui": "^5.7.46",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
